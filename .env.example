# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public site URL (used inside QR codes and emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron sends this as a Bearer token to /api/cron/payment-emails (reminder and
# expiry emails). Any long random string; set it in Vercel too. Without it the cron refuses.
CRON_SECRET=

# ---------------------------------------------------------------- Email
# Provider is chosen automatically: SMTP if SMTP_HOST is set, else Resend if
# RESEND_API_KEY is set, else dry-run (logs to the server console, sends nothing).

# Option A: SMTP (recommended with Microsoft 365). SMTP AUTH must be enabled on the mailbox;
# use an app password if the account has MFA.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true only for implicit TLS on port 465; leave unset for 587 (STARTTLS)

# Option B: Resend API. In test mode only onboarding@resend.dev may send, and only to the account owner's inbox.
RESEND_API_KEY=

# Sender shown to buyers. Must be the SMTP mailbox (or an alias it may send as), or a Resend-verified domain.
EMAIL_FROM="Track & Crawl Fest <tickets@example.com>"
